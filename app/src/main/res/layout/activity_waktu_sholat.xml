<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    tools:context=".ui.waktusholat.WaktuSholatActivity"
    android:background="@color/bg_home_warm">

    <include
        android:id="@+id/includeToolbar"
        layout="@layout/view_toolbar_default"
        android:layout_marginStart="-10dp"
        android:layout_marginEnd="-10dp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_white"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/btnTabActual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_underline_active"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Waktu Aktual"
            android:textColor="@color/text_label_gold"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnTabDetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_underline_inactive"
            android:gravity="center"
            android:paddingVertical="14dp"
            android:text="Detail Perhitungan"
            android:textColor="@color/waktu_sholat_icon_muted"
            android:textStyle="normal"
            android:textSize="14sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/btnCetakJadwalBulanan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:drawablePadding="8dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="Cetak Jadwal Sholat Bulanan (PDF)"
        android:textColor="@color/text_label_gold"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/layoutWaktuSholat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_gradient_navy"
                    android:padding="20dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:alpha="0.85"
                        android:src="@drawable/ic_sparkle"
                        app:tint="@color/gold_accent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:ignore="ContentDescription" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="90dp"
                        android:layout_marginTop="4dp"
                        android:alpha="0.6"
                        android:background="@drawable/dot_star"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="3dp"
                        android:layout_height="3dp"
                        android:layout_marginEnd="36dp"
                        android:alpha="0.55"
                        android:background="@drawable/dot_star"
                        android:backgroundTint="@color/gold_accent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="@color/waktu_sholat_date_muted"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvNextPrayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/loading"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvDate" />

                    <TextView
                        android:id="@+id/tvNextPrayerTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/loading"
                        android:textColor="#D1D5DB"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/tvNextPrayer"
                        app:layout_constraintStart_toEndOf="@id/tvNextPrayer" />

                    <TextView
                        android:id="@+id/tvLocationName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_pill_dark"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:text="@string/loading"
                        android:textColor="@color/waktu_sholat_pill_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_gis_location_poi"
                        app:drawableTint="@color/waktu_sholat_pill_text"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvNextPrayer" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_rounded"
                    android:backgroundTint="@color/card_white"
                    android:padding="6dp">

                    <include layout="@layout/item_prayer_row" android:id="@+id/rowTsulutsulLail"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowImsak"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowSubuh"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowDhuha"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowDzuhur"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowAshar"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowMaghrib"/>
                    <include layout="@layout/item_prayer_row" android:id="@+id/rowIsya"/>

                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/layoutDetailPerhitungan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETAIL PERHITUNGAN WAKTU SHOLAT"
                    android:textStyle="bold"
                    android:textColor="@color/text_label_gold"/>

                <TextView
                    android:id="@+id/tvPrayerBreakdownSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breakdown perhitungan (Ephemeris Approximation)"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint"/>

                <TextView
                    android:id="@+id/tvDetailCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/loading"
                    android:textSize="11sp"
                    android:textColor="@color/text_hint"/>

                <LinearLayout
                    android:id="@+id/layoutPrayerBreakdownContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:id="@+id/tvNoPrayerBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Metode perhitungan yang aktif saat ini tidak punya breakdown detail - nilainya diambil langsung dari Aladhan API, bukan hasil hitung lokal."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:background="@color/input_inline_bg"
                    android:padding="10dp"
                    android:visibility="gone"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="50dp"/>

            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>